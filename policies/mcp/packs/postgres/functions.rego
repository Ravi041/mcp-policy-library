# Functions the Postgres pack refuses in every statement. The pack README says where each name was checked.
package mcp.packs.postgres

# Functions with side effects, that reach the host, or that run SQL hidden in a string. The
# list includes extension functions, since agents often connect as a role that can call them:
# every dblink function, pg_cron's scheduling functions, adminpack's file functions, and the
# functions of tablefunc, xml2, pageinspect, PostGIS, pgsql-http, pg_net, aws_s3, aws_lambda,
# pg_background and Citus that run SQL from a string, name a table in a string or reach the
# network. Extension names were checked in each extension's install script or reference.
default_blocked_functions := {
	"addgeometrycolumn",
	"alter_job",
	"brin_desummarize_range",
	"brin_summarize_new_values",
	"brin_summarize_range",
	"connectby",
	"crosstab",
